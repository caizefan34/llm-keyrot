{
  "name": "llm-keyrot",
  "version": "0.2.0",
  "description": "Zero-dependency, in-process API key rotation for LLM providers with 429 recovery and optional cross-provider fallback.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./adapters/*": {
      "default": "./adapters/*"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "adapters",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/index.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "llm",
    "ai",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "deepseek",
    "groq",
    "openrouter",
    "api-key",
    "key-rotation",
    "rate-limit",
    "rate-limiting",
    "429",
    "retry",
    "failover",
    "fallback",
    "resilience",
    "quota",
    "pool",
    "nodejs",
    "javascript",
    "esm",
    "zero-dependency",
    "in-process"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caizefan34/llm-keyrot.git"
  },
  "bugs": {
    "url": "https://github.com/caizefan34/llm-keyrot/issues"
  },
  "homepage": "https://github.com/caizefan34/llm-keyrot#readme"
}
